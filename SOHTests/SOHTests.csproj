<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <LangVersion>10</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="Moq" Version="4.21.0" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <None Update="SOHLogisticsBox\resources\autobahn_und_bundesstrassen_deutschland.geojson">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SOHModel\SOHModel.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="..\SOHLogisticsBox\resources\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    
    <ItemGroup>
        <Content Include="bin\Debug\net10.0\BigEventTests\resources\walk_v3.geojson" />
        <Content Include="bin\Debug\net10.0\BigEventTests\resources\walk_v5.geojson" />
        <Content Include="res\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="SimulationTests\BicycleTests\**"/>
        <Compile Remove="BigEventTests\**" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Remove="SimulationTests\BicycleTests\**"/>
        <EmbeddedResource Remove="BigEventTests\**" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="SimulationTests\BicycleTests\**"/>
        <None Update="BigEventTests\resources\walk_graph_barclays.geojson">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="BigEventTests\resources\walk_v8.geojson">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="BigEventTests\resources\updated_streets_v7.geojson">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="res\data_inits"/>
        <Folder Include="SimulationTests\CarDrivingTests\LaneChangingTests"/>
    </ItemGroup>

</Project>
